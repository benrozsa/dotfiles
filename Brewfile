# Brewfile - Modern, AI-Ready macOS Setup
# Install all tools with: brew bundle --no-lock

# --- Homebrew Taps ---
tap "homebrew/bundle"

# --- Essential CLI Utilities ---
brew "git"
brew "fzf"          # Fuzzy finder used by our vf/cf aliases
brew "ripgrep"      # Fast searching, needed by RTK and general dev
brew "fd"           # Simple, fast alternative to find
brew "jq"           # JSON parser, used by install.sh to install VS Code extensions
brew "gh"           # GitHub CLI
brew "fnm"          # Fast Node version manager (loaded in .zshrc)
brew "pyenv"        # Python version manager (loaded in .zshrc)
brew "shfmt"        # Shell script formatter used by VS Code and pre-commit
brew "shellcheck"   # Shell script static analysis tool

# --- AI & LLM Utilities ---
brew "rtk"          # Rust Token Killer - cuts up to 90% of bash output agent reads
